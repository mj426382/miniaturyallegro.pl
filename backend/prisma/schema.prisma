// Prisma schema for AllGrafika backend.
// Migrations live in prisma/migrations and are versioned in git.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  name            String?
  googleId        String?   @unique
  credits         Int       @default(0)
  freeCreditsUsed Int       @default(0)
  /// Timestamp of accepting the Terms of Service (regulamin) – required for audit (UŚUDE / RODO).
  termsAcceptedAt DateTime?
  /// Stripe customer id – created lazily on first checkout / subscription.
  stripeCustomerId String?  @unique
  /// JWTs issued before this moment are rejected (set on password reset).
  passwordChangedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  images              Image[]
  transactions        PaymentTransaction[]
  passwordResetTokens PasswordResetToken[]
  subscription        Subscription?
  allegroConnection   AllegroConnection?

  @@map("users")
}

model Image {
  id          String   @id @default(cuid())
  userId      String
  originalUrl String
  filename    String
  /// Cached AI product description (generated once, reused by every generation of this image).
  description String?
  /// Set when the photo was imported from an Allegro offer – enables one-click publishing back.
  allegroOfferId String?
  createdAt   DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations      Generation[]
  offerDescription OfferDescription?

  @@index([userId, createdAt])
  @@map("images")
}

/// AI-written Allegro offer copy (title, HTML description, keywords) attached to an uploaded photo.
/// Created only after at least one graphic was generated for the photo. The first description is a
/// free bonus; AI rewrites spend prompt edits (a few free, then packs for a credit); manual edits are unlimited.
model OfferDescription {
  id              String   @id @default(cuid())
  imageId         String   @unique
  title           String
  body            String
  keywords        String[] @default([])
  /// What the seller told us about the product (features, dimensions, set contents...).
  sellerNotes     String?
  promptEditsUsed Int      @default(0)
  /// Extra prompt edits bought in packs (EDIT_PACK_SIZE each, one credit per pack).
  promptEditsPurchased Int @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@map("offer_descriptions")
}

model Generation {
  id        String           @id @default(cuid())
  imageId   String
  url       String?
  prompt    String?
  style     String?
  status    GenerationStatus @default(PENDING)
  /// User quality feedback: 1 = thumbs up, -1 = thumbs down.
  rating       Int?
  ratingReason String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId])
  @@index([status, createdAt])
  @@map("generations")
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PaymentTransaction {
  id              String   @id @default(cuid())
  userId          String
  /// Stripe Checkout session id (one-time packs) or invoice id (subscription renewals) – idempotency key.
  stripeSessionId String   @unique
  amountPln       Int      // grosze (np. 1000 = 10 zł)
  creditsAdded    Int
  status          String   @default("pending") // pending | completed | failed | expired
  kind            String   @default("package") // package | subscription
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("payment_transactions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the raw token sent by e-mail; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Monthly plan paid through Stripe Billing; credits are granted on every paid invoice.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeSubscriptionId String    @unique
  planId               String
  status               String    // active | past_due | canceled | unpaid | incomplete | trialing
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// OAuth tokens for the Allegro seller account (encrypted at rest with AES-256-GCM).
model AllegroConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  expiresAt             DateTime
  sellerLogin           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("allegro_connections")
}

/// Free "try it without an account" generation from the landing page (lead capture).
model DemoRequest {
  id          String           @id @default(cuid())
  email       String
  ipHash      String
  imageKey    String
  resultKey   String?
  status      GenerationStatus @default(PENDING)
  marketingOk Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([email])
  @@index([ipHash, createdAt])
  @@map("demo_requests")
}
