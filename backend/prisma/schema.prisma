// Prisma schema for AllGrafika backend.
// Migrations live in prisma/migrations and are versioned in git.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  /// Canonical mailbox (lower-case, no +alias, no Gmail dots) – one account per mailbox (spec 13).
  /// Legacy duplicates created before 2026-10-04 hold "<email>#legacy:<id>".
  emailCanonical     String    @unique
  /// Set when the owner clicked the verification link (or signed in with Google). Required to generate and pay.
  emailVerifiedAt    DateTime?
  /// Spec 16: explicit opt-in to tips and reminders (marketing e-mail); null = no consent.
  marketingConsentAt DateTime?
  /// Spec 16: transactional "your bulk batch is ready" e-mail; on by default.
  notifyBatchDone    Boolean   @default(true)
  password           String?
  name               String?
  googleId           String?   @unique
  credits            Int       @default(0)
  freeCreditsUsed    Int       @default(0)
  /// Spec 19: size of this account's free pool, fixed at sign-up (accounts before 2026-10-09: 10).
  freeCreditsLimit   Int       @default(10)
  /// Spec 20: random referral code (no personal data), created on first use.
  referralCode       String?   @unique
  /// Spec 20: the account whose link was used at sign-up.
  referredById       String?
  /// Spec 20: when the referral bonus was paid (after the e-mail was confirmed) – paid once.
  referralRewardedAt DateTime?
  /// Timestamp of accepting the Terms of Service (regulamin) – required for audit (UŚUDE / RODO).
  termsAcceptedAt    DateTime?
  /// Stripe customer id – created lazily on first checkout / subscription.
  stripeCustomerId   String?   @unique
  /// JWTs issued before this moment are rejected (set on password reset).
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  images                  Image[]
  transactions            PaymentTransaction[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  emailLog                EmailLog[]
  notificationBatches     NotificationBatch[]
  creditGrants            CreditGrant[]
  referredBy              User?                    @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals               User[]                   @relation("Referrals")
  subscription            Subscription?
  allegroConnection       AllegroConnection?

  @@index([referredById])
  @@map("users")
}

model Image {
  id             String   @id @default(cuid())
  userId         String
  originalUrl    String
  filename       String
  /// Cached AI product description (generated once, reused by every generation of this image).
  description    String?
  /// Set when the photo was imported from an Allegro offer – enables one-click publishing back.
  allegroOfferId String?
  createdAt      DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations      Generation[]
  offerDescription OfferDescription?

  @@index([userId, createdAt])
  @@map("images")
}

/// AI-written Allegro offer copy (title, HTML description, keywords) attached to an uploaded photo.
/// Created only after at least one graphic was generated for the photo. The first description is a
/// free bonus; AI rewrites spend prompt edits (a few free, then packs for a credit); manual edits are unlimited.
model OfferDescription {
  id                   String   @id @default(cuid())
  imageId              String   @unique
  title                String
  body                 String
  keywords             String[] @default([])
  /// What the seller told us about the product (features, dimensions, set contents...).
  sellerNotes          String?
  promptEditsUsed      Int      @default(0)
  /// Extra prompt edits bought in packs (EDIT_PACK_SIZE each, one credit per pack).
  promptEditsPurchased Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@map("offer_descriptions")
}

model Generation {
  id           String           @id @default(cuid())
  imageId      String
  url          String?
  prompt       String?
  style        String?
  status       GenerationStatus @default(PENDING)
  /// User quality feedback: 1 = thumbs up, -1 = thumbs down.
  rating       Int?
  ratingReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId])
  @@index([status, createdAt])
  @@map("generations")
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PaymentTransaction {
  id              String   @id @default(cuid())
  userId          String
  /// Stripe Checkout session id (one-time packs) or invoice id (subscription renewals) – idempotency key.
  stripeSessionId String   @unique
  amountPln       Int // grosze (np. 1000 = 10 zł)
  creditsAdded    Int
  status          String   @default("pending") // pending | completed | failed | expired
  kind            String   @default("package") // package | subscription
  /// Stripe invoice (with the buyer's tax id when given) – fetched on demand as a fresh PDF link.
  stripeInvoiceId String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("payment_transactions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 of the raw token sent by e-mail; the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// One-time link proving the account owner controls the mailbox (spec 13). Only the SHA-256 is stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Every automatic or admin e-mail sent to a user; (userId, key) makes automatic sends idempotent (spec 16).
model EmailLog {
  id        String   @id @default(cuid())
  userId    String
  /// free-credits-reminder | seasonal | batch-done | admin
  kind      String
  key       String
  subject   String
  /// Stored for admin messages only (the operator's own text).
  body      String?
  /// Admin e-mail address that sent the message.
  sentBy    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([kind, createdAt])
  @@map("email_log")
}

/// A bulk upload of >= 3 photos that should e-mail its owner once every graphic is finished (spec 16).
model NotificationBatch {
  id         String    @id @default(cuid())
  userId     String
  imageIds   String[]
  createdAt  DateTime  @default(now())
  /// Set when the batch is done (mailed, skipped by settings, or expired after 24 h).
  closedAt   DateTime?
  notifiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([closedAt])
  @@map("notification_batches")
}

/// Monthly plan paid through Stripe Billing; credits are granted on every paid invoice.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeSubscriptionId String    @unique
  planId               String
  status               String // active | past_due | canceled | unpaid | incomplete | trialing
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// OAuth tokens for the Allegro seller account (encrypted at rest with AES-256-GCM).
model AllegroConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  expiresAt             DateTime
  sellerLogin           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("allegro_connections")
}

/// Free "try it without an account" generation from the landing page (lead capture).
model DemoRequest {
  id             String           @id @default(cuid())
  email          String
  /// Canonical mailbox – the per-mailbox demo limit counts by this (spec 13).
  emailCanonical String?
  ipHash         String
  imageKey       String
  resultKey      String?
  status         GenerationStatus @default(PENDING)
  marketingOk    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  @@index([email])
  @@index([emailCanonical])
  @@index([ipHash, createdAt])
  @@map("demo_requests")
}

/// Spec 19: credits added by an administrator (gift or support), kept for accountability.
model CreditGrant {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  /// Admin e-mail address that granted the credits.
  grantedBy String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("credit_grants")
}
