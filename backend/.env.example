# ───────────────────────── Core ─────────────────────────
NODE_ENV=development
PORT=3000
# Comma separated extra CORS origins (production domains are built in)
# CORS_ORIGINS=https://app.allgrafika.pl,https://allgrafika.pl
# Set to true when running behind nginx/Cloudflare so rate limiting sees real client IPs
TRUST_PROXY=false
# Swagger UI at /api/docs (defaults: on in development, off in production)
SWAGGER_ENABLED=true
# Global rate limit per IP per minute
THROTTLE_LIMIT_PER_MINUTE=120
# Operator accounts (comma separated e-mails) allowed to call /api/admin/*
ADMIN_EMAILS=""
# Session cookie domain (leave empty = API host only)
COOKIE_DOMAIN=""

# ───────────────────────── Database ─────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/AllGrafika?schema=public"

# ───────────────────────── Auth ─────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change_this_to_a_very_long_random_secret_at_least_32_chars"
JWT_EXPIRES_IN="7d"
# Google Sign-In (OAuth client id of type "Web application")
GOOGLE_CLIENT_ID=""

# ───────────────────────── Storage (Backblaze B2, S3 compatible) ─────────────
# Leave B2_* empty to store files on local disk (development only)
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_BUCKET_NAME=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_REGION="us-west-004"
B2_PUBLIC_URL=""
LOCAL_UPLOAD_DIR="./uploads"
# Origin of this API used to build absolute URLs for locally stored files (dev only, e.g. http://localhost:3000)
API_PUBLIC_URL=""

# ───────────────────────── AI providers ─────────────────
# Gemini – image generation (image → image)
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
GEMINI_ASPECT_RATIO="1:1"
# Max simultaneous image generations for the whole process (provider quota guard)
GEMINI_MAX_CONCURRENT=4
# OpenAI – product analysis + prompt engineering (cheap text model)
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-4o-mini"

# ───────────────────────── Business rules ───────────────
# Free generations for every new account (must match the Terms of Service!)
FREE_CREDITS_LIMIT=10
# Styles generated by default when the user does not pick any (comma separated ids)
DEFAULT_STYLE_IDS="white-bg,lifestyle-home,dark-luxury"

# ───────────────────────── Payments (Stripe) ────────────
STRIPE_SECRET_KEY="sk_test_PLACEHOLDER"
STRIPE_WEBHOOK_SECRET="whsec_PLACEHOLDER"
# Monthly plans: create recurring Prices in the Stripe dashboard (49 zł / 149 zł per month)
# and paste their ids here. A plan without a price id is hidden from users.
STRIPE_PRICE_SUB_START=""
STRIPE_PRICE_SUB_PRO=""

# ───────────────────────── Allegro integration ──────────
# Register an app at https://apps.developer.allegro.pl (type: "web", redirect = FRONTEND_URL/allegro/callback)
ALLEGRO_CLIENT_ID=""
ALLEGRO_CLIENT_SECRET=""
# ALLEGRO_REDIRECT_URI="https://app.allgrafika.pl/allegro/callback"
ALLEGRO_SANDBOX=false
# 32+ random chars used to encrypt seller tokens at rest (falls back to JWT_SECRET)
ALLEGRO_TOKEN_KEY=""

# ───────────────────────── Landing page demo ────────────
# Free sample generation without an account (lead capture); set to false to disable
DEMO_ENABLED=true
LANDING_URL="https://allgrafika.pl"

# ───────────────────────── E-mail (password reset) ──────
# Leave SMTP_HOST empty to log e-mails to the console instead of sending
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AllGrafika <no-reply@allgrafika.pl>"

# ───────────────────────── App URLs ─────────────────────
FRONTEND_URL="http://localhost:5173"

# ───────────────────────── Observability ────────────────
# Structured logs: pino JSON in production, pretty in development. LOG_LEVEL: trace|debug|info|warn|error|silent
LOG_LEVEL=""
# Error reporting (optional). Leave empty to disable.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"
