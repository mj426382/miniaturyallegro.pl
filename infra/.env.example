# Postgres
POSTGRES_USER=postgres
# Use URL-safe characters only (letters, digits, - _) – the password is interpolated into DATABASE_URL
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=AllGrafika

# JWT – generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Google Sign-In
GOOGLE_CLIENT_ID=

# Backblaze B2
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET_NAME=your-bucket-name
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key
B2_REGION=us-west-004
B2_PUBLIC_URL=https://f004.backblazeb2.com/file/your-bucket-name

# AI providers
GEMINI_API_KEY=your-gemini-api-key
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_ASPECT_RATIO=1:1
OPENAI_API_KEY=your-openai-api-key
OPENAI_TEXT_MODEL=gpt-4o-mini

# Business rules (FREE_CREDITS_LIMIT must match the Terms of Service)
FREE_CREDITS_LIMIT=10
DEFAULT_STYLE_IDS=white-bg,lifestyle-home,dark-luxury

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SUB_START=
STRIPE_PRICE_SUB_PRO=

# Allegro integration (apps.developer.allegro.pl)
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_SANDBOX=false
ALLEGRO_TOKEN_KEY=

# Landing page demo
DEMO_ENABLED=true
LANDING_URL=https://allgrafika.pl

# E-mail (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AllGrafika <no-reply@allgrafika.pl>

# App URLs / security
FRONTEND_URL=https://app.allgrafika.pl
TRUST_PROXY=true
SWAGGER_ENABLED=false
THROTTLE_LIMIT_PER_MINUTE=120
